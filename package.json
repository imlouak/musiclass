{
  "name": "musiclass",
  "version": "0.2.3",
  "type": "module",
  "author": "MusiClass",
  "private": true,
  "description": "Retrouvez instantanément vos partitions dans vos classeurs physiques.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "test": "node --test electron/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.10",
    "lucide-react": "latest",
    "pdf-parse": "^2.4.5",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "fr.musiclass.app",
    "productName": "MusiClass",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "imlouak",
        "repo": "musiclass",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MusiClass.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "MusiClass.${ext}",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    }
  }
}
